# Sanity CMS — copy to .env.local and fill in after creating your Sanity project.
# Find these values at https://www.sanity.io/manage → your project.

# Public project identifiers (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only secret shared with the Sanity publish webhook (any random string).
# Set the same value in the Sanity webhook URL: /api/revalidate?secret=...
SANITY_REVALIDATE_SECRET=

# Server-only write token with Editor role. Create at sanity.io/manage -> API -> Tokens.
# Only used by scripts (e.g. npm run sanity:seed) — never exposed to the browser.
SANITY_API_TOKEN=
