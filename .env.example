# ── Site identity ───────────────────────────────────────────────────────────

# Public. The canonical origin, used for metadataBase, canonical tags, the
# sitemap, and JSON-LD. No trailing slash, e.g. https://example.com
#
# Unset, it falls back to Vercel's own deployment hostname (and then to
# localhost), which is fine for previews but wrong for production: canonical
# tags pointing at an address you don't own are worse than none at all. Set
# this to the real domain as soon as one exists.
NEXT_PUBLIC_SITE_URL=

# Sanity CMS — copy to .env.local and fill in after creating your Sanity project.
# Find these values at https://www.sanity.io/manage → your project.

# Public project identifiers (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only secret shared with the Sanity publish webhook (any random string).
# Set the same value in the Sanity webhook URL: /api/revalidate?secret=...
SANITY_REVALIDATE_SECRET=

# Server-only write token with Editor role. Create at sanity.io/manage -> API -> Tokens.
# Only used by scripts (e.g. npm run sanity:seed) — never exposed to the browser.
SANITY_API_TOKEN=

# ── Contact form ────────────────────────────────────────────────────────────

# Server-only. Transactional email for /contact. Create at resend.com/api-keys.
# Unset, the form degrades to a prefilled mailto instead of erroring.
RESEND_API_KEY=

# Sender address. Resend will not send from an arbitrary address: either use an
# address on a domain you have verified in Resend (DNS records), or leave this
# unset to use the onboarding@resend.dev sandbox — which needs no DNS but can
# only deliver to the email your Resend account is registered under.
CONTACT_FROM_EMAIL=

# Where submissions land. Falls back to Sanity's siteSettings.email.
# Using the sandbox sender above, this MUST be your Resend account email or
# Resend returns a 403.
CONTACT_TO_EMAIL=

# Public. Calendly scheduling link embedded in the form's success state, e.g.
# https://calendly.com/your-handle/30min — unset, the embed is simply omitted.
NEXT_PUBLIC_CALENDLY_URL=
